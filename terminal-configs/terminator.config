# Managed by dotfiles → symlinked to ~/.config/terminator/config
# Terminator uses fontconfig, so any name from `fc-list` works.
[global_config]
[keybindings]
[profiles]
  [[default]]
    use_system_font = False
    font = FiraCode Nerd Font Mono 12
    scrollback_infinite = True
    # font = Hack Nerd Font Mono 12
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
[plugins]
