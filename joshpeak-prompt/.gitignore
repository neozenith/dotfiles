bin/*
# Commit the per-architecture release binaries; the host theme selects the right
# one at runtime. The unsuffixed bin/joshpeak-prompt is a local build artifact.
!bin/joshpeak-prompt-darwin-arm64
!bin/joshpeak-prompt-darwin-amd64
!bin/joshpeak-prompt-linux-arm64
!bin/joshpeak-prompt-linux-amd64

tmp/

# APM dependencies
apm_modules/


.codex/
.agents/
.claude/
